{
  "name": "vue3renderer",
  "version": "0.1.1",
  "description": "渲染器：把 .vue 单文件组件或网页渲染成 PNG 截图，常驻浏览器、并发限流、props 数据驱动。",
  "type": "module",
  "main": "dist/render.js",
  "types": "dist/render.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "screenshot",
    "playwright",
    "ssr",
    "sfc",
    "png"
  ],
  "license": "MIT",
  "dependencies": {
    "vue3tohtml": "^1.2.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
